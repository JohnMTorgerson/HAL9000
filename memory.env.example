# Copy these into the .env HAL already loads. This file isn't loaded automatically.
# Memory makes paid background API calls after replies and to tag older entries.
# Foreground recall is local; memory is disabled unless enabled.
MEMORY_ENABLED=true
MEMORY_MODEL=gpt-6-luna
MEMORY_REASONING_EFFORT=medium

# Optional defaults (relative directory is resolved from the repository root).
# MEMORY_DIR=data/memory
# MEMORY_MAX_COMPLETION_TOKENS=8192
# MEMORY_TIMEOUT_SECONDS=120
# Approximate token limit for selected records, not a storage/deletion limit.
# Used for foreground recall and the updater's relevant existing-memory context.
# MEMORY_SOFT_TOKEN_BUDGET=3000

# Searches, matching terms, selected records, and decisions go to memory.log in LOG_PATH.
# Foreground LLM_MODEL/LLM_SERVICE_TIER settings are independent.
